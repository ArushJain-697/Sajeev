+package io.mosip.registration.test.liveness;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.util.Iterator;
+
+import javax.imageio.ImageIO;
+import javax.imageio.ImageWriter;
+import javax.imageio.stream.MemoryCacheImageOutputStream;
+
+import org.junit.Test;
+
+import io.mosip.registration.service.liveness.CapturedFaceImage;
+
+public class CapturedFaceImageTest {
+
+	private static BufferedImage sample() {
+		BufferedImage img = new BufferedImage(32, 32, BufferedImage.TYPE_INT_RGB);
+		for (int y = 0; y < 32; y++) {
+			for (int x = 0; x < 32; x++) {
+				img.setRGB(x, y, (x * 8) << 16 | (y * 8) << 8 | 90);
+			}
+		}
+		return img;
+	}
+
+	private static byte[] jp2(BufferedImage img) throws Exception {
+		Iterator<ImageWriter> it = ImageIO.getImageWritersByFormatName("jpeg2000");
+		assertTrue("the JPEG 2000 plugin (jai-imageio-jpeg2000) is not on the classpath", it.hasNext());
+		ImageWriter w = it.next();
+		ByteArrayOutputStream o = new ByteArrayOutputStream();
+		try (MemoryCacheImageOutputStream out = new MemoryCacheImageOutputStream(o)) {
+			w.setOutput(out);
+			w.write(img);
+		}
+		w.dispose();
+		return o.toByteArray();
+	}
+
+	@Test
+	public void test_jpeg2000_inside_an_iso_record_is_decoded_to_png() throws Exception {
+		byte[] image = jp2(sample());
+		byte[] header = new byte[60]; // stands in for the ISO 19794-5 header and face information block
+		byte[] iso = new byte[header.length + image.length];
+		System.arraycopy(header, 0, iso, 0, header.length);
+		System.arraycopy(image, 0, iso, header.length, image.length);
+		byte[] png = CapturedFaceImage.toPng(iso);
+		assertNotNull(png);
+		BufferedImage back = ImageIO.read(new ByteArrayInputStream(png));
+		assertEquals(32, back.getWidth());
+		assertEquals(32, back.getHeight());
+	}
+
+	@Test
+	public void test_bare_jpeg_and_png_pass_through() throws Exception {
+		ByteArrayOutputStream o = new ByteArrayOutputStream();
+		ImageIO.write(sample(), "jpg", o);
+		assertNotNull(CapturedFaceImage.toPng(o.toByteArray()));
+		o.reset();
+		ImageIO.write(sample(), "png", o);
+		assertNotNull(CapturedFaceImage.toPng(o.toByteArray()));
+	}
+
+	@Test
+	public void test_garbage_and_empty_give_null() {
+		assertNull(CapturedFaceImage.toPng(new byte[] { 1, 2, 3, 4 }));
+		assertNull(CapturedFaceImage.toPng(new byte[0]));
+		assertNull(CapturedFaceImage.toPng(null));
+	}
+}
diff --git a/registration/registration-services/src/test/java/io/mosip/registration/test/liveness/LivenessCaptureCoordinatorTest.java b/registration/registration-services/src/test/java/io/mosip/registration/test/liveness/LivenessCaptureCoordinatorTest.java
new file mode 100644
index 0000000..8dd1ebf
--- /dev/null
+++ b/registration/registration-services/src/test/java/io/mosip/registration/test/liveness/LivenessCaptureCoordinatorTest.java
@@ -0,0 +1,156 @@
+package io.mosip.registration.test.liveness;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.util.Collections;
+
+import org.junit.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import io.mosip.registration.api.liveness.LivenessCaptureCheck;
+import io.mosip.registration.api.liveness.LivenessFacade;
+import io.mosip.registration.api.liveness.LivenessProgress;
+import io.mosip.registration.api.liveness.LivenessProgress.Phase;
+import io.mosip.registration.api.liveness.LivenessSessionHandle;
+import io.mosip.registration.api.liveness.LivenessSessionProvider;
+import io.mosip.registration.service.liveness.LivenessCaptureCoordinator;
+import io.mosip.registration.service.liveness.LivenessCaptureCoordinator.Gate;
+
+public class LivenessCaptureCoordinatorTest {
+
+	private static final byte[] NOT_AN_IMAGE = { 1, 2, 3 };
+
+	/** A session whose phase and binding answer are set by the test. */
+	private static final class Fake implements LivenessSessionHandle {
+		Phase phase;
+		boolean bound;
+		int frames;
+		boolean closed;
+
+		Fake(Phase phase, boolean bound) {
+			this.phase = phase;
+			this.bound = bound;
+		}
+
+		public void onFrame(byte[] jpeg) {
+			frames++;
+		}
+
+		public LivenessProgress progress() {
+			return new LivenessProgress(phase, null, null, "fake");
+		}
+
+		public LivenessCaptureCheck checkCapture(byte[] image, long timeout) {
+			return new LivenessCaptureCheck(bound, bound ? "" : "embedding");
+		}
+
+		public void close() {
+			closed = true;
+		}
+	}
+
+	private static LivenessCaptureCoordinator with(Fake fake) {
+		LivenessFacade f = new LivenessFacade();
+		LivenessSessionProvider p = new LivenessSessionProvider() {
+			public String getServiceName() {
+				return "fake";
+			}
+
+			public LivenessSessionHandle open(String w) {
+				return fake;
+			}
+		};
+		ReflectionTestUtils.setField(f, "sessionProviders", Collections.singletonList(p));
+		LivenessCaptureCoordinator c = new LivenessCaptureCoordinator(f);
+		c.begin("RESIDENT");
+		return c;
+	}
+
+	/** A real PNG so that the capture decodes; the Fake decides the binding. */
+	private static byte[] png() throws Exception {
+		java.awt.image.BufferedImage img = new java.awt.image.BufferedImage(8, 8, java.awt.image.BufferedImage.TYPE_INT_RGB);
+		java.io.ByteArrayOutputStream o = new java.io.ByteArrayOutputStream();
+		javax.imageio.ImageIO.write(img, "png", o);
+		return o.toByteArray();
+	}
+
+	@Test
+	public void test_capture_never_stored_without_binding() throws Exception {
+		assertEquals(Gate.REFUSE_UNBOUND, with(new Fake(Phase.LIVE, false)).decideStore(png(), 3000));
+		assertEquals(Gate.STORE, with(new Fake(Phase.LIVE, true)).decideStore(png(), 3000));
+		// a capture that cannot even be decoded is never bound
+		assertEquals(Gate.REFUSE_UNBOUND, with(new Fake(Phase.LIVE, true)).decideStore(NOT_AN_IMAGE, 3000));
+	}
+
+	@Test
+	public void test_non_live_face_never_reaches_registration_dto() throws Exception {
+		for (Phase p : new Phase[] { Phase.RUNNING, Phase.NOT_LIVE, Phase.UNAVAILABLE }) {
+			// even if the binding check would say yes, a session that is not LIVE never stores
+			Gate g = with(new Fake(p, true)).decideStore(png(), 3000);
+			assertNotEquals("phase " + p + " was allowed to store", Gate.STORE, g);
+		}
+		// no session at all (no facade, or begin() never called)
+		assertNotEquals(Gate.STORE, new LivenessCaptureCoordinator().decideStore(png(), 3000));
+		LivenessCaptureCoordinator c = new LivenessCaptureCoordinator(new LivenessFacade());
+		c.begin("RESIDENT"); // no provider: the facade gives an UNAVAILABLE session
+		assertEquals(Gate.REFUSE_UNAVAILABLE, c.decideStore(png(), 3000));
+		assertEquals(Gate.REFUSE_UNAVAILABLE, c.pollBeforeCapture());
+	}
+
+	@Test
+	public void test_retry_limit_enforced() {
+		LivenessCaptureCoordinator c = with(new Fake(Phase.NOT_LIVE, false));
+		c.setMaxRetries(2);
+		assertFalse(c.retriesExhausted());
+		assertEquals(Gate.REFUSE_NOT_LIVE, c.pollBeforeCapture());
+		assertFalse(c.retriesExhausted());
+		assertEquals(Gate.REFUSE_NOT_LIVE, c.pollBeforeCapture());
+		assertTrue(c.retriesExhausted());
+		assertEquals(2, c.failedAttempts());
+		c.resetAttempts();
+		assertFalse(c.retriesExhausted());
+	}
+
+	@Test
+	public void test_unavailable_engine_does_not_use_up_a_retry() {
+		LivenessCaptureCoordinator c = with(new Fake(Phase.UNAVAILABLE, false));
+		assertEquals(Gate.REFUSE_UNAVAILABLE, c.pollBeforeCapture());
+		assertEquals(0, c.failedAttempts());
+	}
+
+	@Test
+	public void test_capture_starts_only_when_live() {
+		Fake f = new Fake(Phase.RUNNING, false);
+		LivenessCaptureCoordinator c = with(f);
+		assertEquals(Gate.WAIT, c.pollBeforeCapture());
+		f.phase = Phase.LIVE;
+		assertEquals(Gate.START_CAPTURE, c.pollBeforeCapture());
+	}
+
+	@Test
+	public void test_a_session_with_no_verdict_times_out_closed() throws Exception {
+		Fake f = new Fake(Phase.RUNNING, false);
+		LivenessCaptureCoordinator c = with(f);
+		c.setSessionTimeoutMillis(10);
+		Thread.sleep(40);
+		assertEquals(Gate.REFUSE_UNAVAILABLE, c.pollBeforeCapture());
+		assertTrue("the timed-out session was not closed", f.closed);
+	}
+
+	@Test
+	public void test_frames_reach_the_session_and_end_releases_it() {
+		Fake f = new Fake(Phase.RUNNING, false);
+		LivenessCaptureCoordinator c = with(f);
+		c.onFrame(NOT_AN_IMAGE);
+		c.onFrame(NOT_AN_IMAGE);
+		assertEquals(2, f.frames);
+		c.end();
+		c.end(); // twice is fine
+		assertTrue(f.closed);
+		c.onFrame(NOT_AN_IMAGE); // after end: ignored
+		assertEquals(2, f.frames);
+	}
+}
diff --git a/registration/registration-services/src/test/java/io/mosip/registration/test/liveness/SajeevLivenessProviderTest.java b/registration/registration-services/src/test/java/io/mosip/registration/test/liveness/SajeevLivenessProviderTest.java
new file mode 100644
index 0000000..a6bb41e
--- /dev/null
+++ b/registration/registration-services/src/test/java/io/mosip/registration/test/liveness/SajeevLivenessProviderTest.java
@@ -0,0 +1,69 @@
+package io.mosip.registration.test.liveness;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assume.assumeNotNull;
+
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.util.Collections;
+
+import org.junit.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import io.mosip.registration.api.liveness.LivenessFacade;
+import io.mosip.registration.api.liveness.LivenessProgress;
+import io.mosip.registration.api.liveness.LivenessSessionHandle;
+import io.mosip.registration.service.liveness.SajeevLivenessProvider;
+
+public class SajeevLivenessProviderTest {
+
+	private static LivenessFacade facadeWith(SajeevLivenessProvider p) {
+		LivenessFacade f = new LivenessFacade();
+		ReflectionTestUtils.setField(f, "sessionProviders", Collections.singletonList(p));
+		return f;
+	}
+
+	@Test
+	public void test_engine_that_cannot_load_models_fails_closed() {
+		String before = System.getProperty("mosip.registration.liveness.model.dir");
+		System.setProperty("mosip.registration.liveness.model.dir", "/definitely/not/here");
+		try {
+			SajeevLivenessProvider p = new SajeevLivenessProvider();
+			LivenessSessionHandle h = facadeWith(p).openSession("RESIDENT");
+			assertEquals(LivenessProgress.Phase.UNAVAILABLE, h.progress().getPhase());
+			assertFalse(h.checkCapture(new byte[] { 1 }, 3000).isBound());
+			p.shutdown();
+		} finally {
+			if (before == null) {
+				System.clearProperty("mosip.registration.liveness.model.dir");
+			} else {
+				System.setProperty("mosip.registration.liveness.model.dir", before);
+			}
+		}
+	}
+
+	/** Needs the SAJEEV models (-Dmosip.registration.liveness.model.dir=...) and a face photo (-Dsajeev.face.jpg=...). */
+	@Test
+	public void test_a_photo_of_a_face_is_never_live_through_the_real_engine() throws Exception {
+		String models = System.getProperty("mosip.registration.liveness.model.dir");
+		String photo = System.getProperty("sajeev.face.jpg");
+		assumeNotNull(models, photo);
+		byte[] jpg = Files.readAllBytes(Paths.get(photo));
+		SajeevLivenessProvider p = new SajeevLivenessProvider();
+		try {
+			LivenessSessionHandle h = facadeWith(p).openSession("RESIDENT");
+			long end = System.currentTimeMillis() + 40_000;
