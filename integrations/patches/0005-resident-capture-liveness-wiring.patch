+    @Test
+    public void test_no_session_provider_fails_closed() {
+        LivenessFacade f = new LivenessFacade();
+        LivenessSessionHandle h = f.openSession("RESIDENT");
+        assertEquals(LivenessProgress.Phase.UNAVAILABLE, h.progress().getPhase());
