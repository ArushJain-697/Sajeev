--- /dev/null
+++ b/registration/registration-services/src/main/java/io/mosip/registration/service/liveness/CapturedFaceImage.java
@@ -0,0 +1,59 @@
+package io.mosip.registration.service.liveness;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+
+import javax.imageio.ImageIO;
+
+/**
+ * Turns what the device returned (an ISO 19794-5 face record with a JPEG 2000 image inside, or a plain image) into a
+ * PNG that the liveness engine can decode. The client already ships the JPEG 2000 reader (jai-imageio-jpeg2000).
+ */
+public final class CapturedFaceImage {
+
+	private static final byte[] JP2_SIGNATURE = { 0x00, 0x00, 0x00, 0x0C, 0x6A, 0x50, 0x20, 0x20, 0x0D, 0x0A, (byte) 0x87, 0x0A };
+	private static final byte[] J2K_CODESTREAM = { (byte) 0xFF, 0x4F, (byte) 0xFF, 0x51 };
+
+	private CapturedFaceImage() {
+	}
+
+	/**
+	 * @param isoOrImage the bytes of the captured face (ISO 19794-5 record, bare JPEG 2000, JPEG or PNG)
+	 * @return PNG bytes, or null when nothing could be decoded
+	 */
+	public static byte[] toPng(byte[] isoOrImage) {
+		if (isoOrImage == null || isoOrImage.length == 0) {
+			return null;
+		}
+		int at = indexOf(isoOrImage, JP2_SIGNATURE);
+		if (at < 0) {
+			at = indexOf(isoOrImage, J2K_CODESTREAM);
+		}
+		byte[] image = at > 0 ? java.util.Arrays.copyOfRange(isoOrImage, at, isoOrImage.length) : isoOrImage;
+		try {
+			BufferedImage img = ImageIO.read(new ByteArrayInputStream(image));
+			if (img == null) {
+				return null;
+			}
+			ByteArrayOutputStream out = new ByteArrayOutputStream();
+			ImageIO.write(img, "png", out);
+			return out.toByteArray();
+		} catch (IOException | RuntimeException e) {
+			return null;
+		}
+	}
+
+	private static int indexOf(byte[] data, byte[] pattern) {
+		outer: for (int i = 0; i <= data.length - pattern.length; i++) {
+			for (int j = 0; j < pattern.length; j++) {
+				if (data[i + j] != pattern[j]) {
+					continue outer;
+				}
+			}
+			return i;
+		}
+		return -1;
+	}
+}
diff --git a/registration/registration-services/src/main/java/io/mosip/registration/service/liveness/LivenessCaptureCoordinator.java b/registration/registration-services/src/main/java/io/mosip/registration/service/liveness/LivenessCaptureCoordinator.java
new file mode 100644
index 0000000..7a5b0d4
--- /dev/null
+++ b/registration/registration-services/src/main/java/io/mosip/registration/service/liveness/LivenessCaptureCoordinator.java
@@ -0,0 +1,225 @@
+package io.mosip.registration.service.liveness;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Component;
+
+import io.mosip.registration.audit.AuditManagerService;
+import io.mosip.registration.constants.AuditEvent;
+import io.mosip.registration.constants.Components;
+import io.mosip.registration.api.liveness.LivenessCaptureCheck;
+import io.mosip.registration.api.liveness.LivenessFacade;
+import io.mosip.registration.api.liveness.LivenessProgress;
+import io.mosip.registration.api.liveness.LivenessSessionHandle;
+
+/**
+ * Decides, for the face capture screen, when the capture may start and whether a captured face may be stored.
+ * Plain logic with no screen code, so it can be tested without JavaFX.
+ *
+ * <p>Rules (SAJEEV invariants): a face is stored only if the session reached LIVE and the captured face is bound to the
+ * face seen live (no orphan capture); anything else, including a missing or failed engine, refuses (fail closed);
+ * failed attempts are counted and stop at the retry limit.</p>
+ */
+@Component
+public class LivenessCaptureCoordinator {
+
+	private static final Logger LOGGER = LoggerFactory.getLogger(LivenessCaptureCoordinator.class);
+
+	/** What the screen should do next. */
+	public enum Gate {
+		/** Frames are still being checked: keep the stream running and show the guidance. */
+		WAIT,
+		/** The person is live: start the capture. */
+		START_CAPTURE,
+		/** The captured face is live and bound: it may be stored. */
+		STORE,
+		/** Presentation attack, failed challenge or no live proof. The capture is refused and counts as a failed attempt. */
+		REFUSE_NOT_LIVE,
+		/** The captured face is not the face seen live. Refused, counts as a failed attempt. */
+		REFUSE_UNBOUND,
+		/** The engine is missing or could not judge. Refused; does not use up a retry. */
+		REFUSE_UNAVAILABLE
+	}
+
+	@Autowired(required = false)
+	private LivenessFacade livenessFacade;
+
+	@Autowired(required = false)
+	private AuditManagerService auditFactory;
+
+	private LivenessSessionHandle session;
+	private String workflow;
+	private long startedMillis;
+	private long sessionTimeoutMillis = 45_000;
+	private final java.util.Map<String, Integer> failures = new java.util.HashMap<>();
+	private int maxRetries = 3;
+
+	public LivenessCaptureCoordinator() {
+	}
+
+	/** For tests and for code outside Spring. */
+	public LivenessCaptureCoordinator(LivenessFacade facade) {
+		this.livenessFacade = facade;
+	}
+
+	/** For tests: the audit sink. */
+	public void setAuditManager(AuditManagerService audit) {
+		this.auditFactory = audit;
+	}
+
+	private void audit(AuditEvent event) {
+		try {
+			if (auditFactory != null) {
+				auditFactory.audit(event, Components.REG_BIOMETRICS, workflow == null ? "LIVENESS" : workflow, "workflow");
+			}
+		} catch (RuntimeException e) {
+			LOGGER.error("Writing the liveness audit event failed", e); // an audit failure must never change the decision
+		}
+	}
+
+	public synchronized void setMaxRetries(int maxRetries) {
+		this.maxRetries = Math.max(1, maxRetries);
+	}
+
+	public synchronized void setSessionTimeoutMillis(long millis) {
+		this.sessionTimeoutMillis = millis;
+	}
+
+	/**
+	 * Start a liveness session for a new capture attempt. The failed-attempt count is kept across attempts for the
+	 * same registration; call {@link #resetAttempts()} when the person or the step changes.
+	 *
+	 * @param workflow RESIDENT, OPERATOR or SUPERVISOR
+	 */
+	public synchronized void begin(String workflow) {
+		end();
+		this.workflow = workflow;
+		this.maxRetries = LivenessClientConfig.maxRetries();
+		this.sessionTimeoutMillis = LivenessClientConfig.sessionTimeoutMillis();
+		this.startedMillis = System.currentTimeMillis();
+		this.session = livenessFacade == null ? null : livenessFacade.openSession(workflow);
+		audit(AuditEvent.REG_LIVENESS_START);
+		if (session == null || session.progress().getPhase() == LivenessProgress.Phase.UNAVAILABLE) {
+			audit(AuditEvent.REG_LIVENESS_ENGINE_UNAVAILABLE);
+		}
+	}
+
+	/** @param jpeg a frame from the device stream; never blocks */
+	public void onFrame(byte[] jpeg) {
+		LivenessSessionHandle s = session;
+		if (s != null) {
+			s.onFrame(jpeg);
+		}
+	}
+
+	/** @return the progress for the screen; UNAVAILABLE when no session is open */
+	public synchronized LivenessProgress progress() {
+		if (session == null) {
+			return new LivenessProgress(LivenessProgress.Phase.UNAVAILABLE, null, "liveness.error.engine", "not_started");
+		}
+		return session.progress();
+	}
+
+	/**
+	 * Called while the stream is shown, before the capture starts.
+	 * @return WAIT, START_CAPTURE, REFUSE_NOT_LIVE or REFUSE_UNAVAILABLE
+	 */
+	public synchronized Gate pollBeforeCapture() {
+		LivenessProgress p = progress();
+		switch (p.getPhase()) {
+		case LIVE:
+			audit(AuditEvent.REG_LIVENESS_VERDICT);
+			return Gate.START_CAPTURE;
+		case RUNNING:
+			if (System.currentTimeMillis() - startedMillis > sessionTimeoutMillis) {
+				LOGGER.warn("Liveness session timed out without a verdict");
+				end();
+				return Gate.REFUSE_UNAVAILABLE;
+			}
+			return Gate.WAIT;
+		case NOT_LIVE:
+			countFailure();
+			audit(AuditEvent.REG_LIVENESS_VERDICT);
+			return Gate.REFUSE_NOT_LIVE;
+		default:
+			return Gate.REFUSE_UNAVAILABLE;
+		}
+	}
+
+	/**
+	 * Called in the capture's success handler, BEFORE anything is stored or de-duplicated.
+	 *
+	 * @param capturedIsoOrImage the captured face as returned by the device
+	 * @param captureTimeoutMillis the device capture timeout
+	 * @return STORE only if the session is LIVE and the capture is bound to the live face
+	 */
+	public synchronized Gate decideStore(byte[] capturedIsoOrImage, long captureTimeoutMillis) {
+		if (session == null) {
+			return Gate.REFUSE_UNAVAILABLE;
+		}
+		LivenessProgress p = session.progress();
+		if (!p.isLive()) {
+			if (p.getPhase() == LivenessProgress.Phase.UNAVAILABLE) {
+				return Gate.REFUSE_UNAVAILABLE;
+			}
+			countFailure();
+			return Gate.REFUSE_NOT_LIVE;
+		}
+		byte[] png = CapturedFaceImage.toPng(capturedIsoOrImage);
+		LivenessCaptureCheck check = png == null ? new LivenessCaptureCheck(false, "undecodable_capture")
+				: session.checkCapture(png, captureTimeoutMillis);
+		audit(AuditEvent.REG_LIVENESS_BINDING);
+		if (!check.isBound()) {
+			countFailure();
+			LOGGER.warn("Captured face refused: {}", check.getReason());
+			return Gate.REFUSE_UNBOUND;
+		}
+		failures.put(key(), 0);
+		end(); // one live verdict stores one capture
+		return Gate.STORE;
+	}
+
+	/** @return true when the retry limit is reached: the screen must stop offering another attempt */
+	public synchronized boolean retriesExhausted() {
+		return failures.getOrDefault(key(), 0) >= maxRetries;
+	}
+
+	/** @return true when this workflow has used all its attempts (checked before a session starts) */
+	public synchronized boolean retriesExhausted(String workflowName) {
+		return failures.getOrDefault(workflowName, 0) >= LivenessClientConfig.maxRetries();
+	}
+
+	public synchronized int failedAttempts() {
+		return failures.getOrDefault(key(), 0);
+	}
+
+	public synchronized void resetAttempts() {
+		failures.clear();
+	}
+
+	/** Starts a new attempt flow for one workflow (a new registration or a new login): its counter only. */
+	public synchronized void resetAttempts(String workflowName) {
+		failures.remove(workflowName);
+	}
+
+	private String key() {
+		return workflow == null ? "LIVENESS" : workflow;
+	}
+
+	private void countFailure() {
+		failures.merge(key(), 1, Integer::sum);
+	}
+
+	/** Close the session and release its frames. Safe to call more than once. */
+	public synchronized void end() {
+		if (session != null) {
+			try {
+				session.close();
+			} catch (RuntimeException e) {
+				LOGGER.error("Closing the liveness session failed", e);
+			}
+			session = null;
+		}
+	}
+}
diff --git a/registration/registration-services/src/main/java/io/mosip/registration/service/liveness/LivenessClientConfig.java b/registration/registration-services/src/main/java/io/mosip/registration/service/liveness/LivenessClientConfig.java
new file mode 100644
index 0000000..50e9ec2
--- /dev/null
+++ b/registration/registration-services/src/main/java/io/mosip/registration/service/liveness/LivenessClientConfig.java
@@ -0,0 +1,97 @@
+package io.mosip.registration.service.liveness;
+
+import io.mosip.registration.context.ApplicationContext;
+
+/**
+ * Liveness settings from the client's configuration (global parameters synced from the server, or local), each with a
+ * client-side default so that the client works when the server does not send them. A bad or missing value never
+ * disables liveness: it falls back to the default.
+ */
+public final class LivenessClientConfig {
+
+	public static final String PREFIX = "mosip.registration.liveness.";
+	public static final String ENABLED = PREFIX + "enabled";
+	public static final String MAX_RETRIES = PREFIX + "maxRetries";
+	public static final String SESSION_TIMEOUT_MS = PREFIX + "sessionTimeoutMs";
+	public static final String GUIDANCE_OVERRIDES = PREFIX + "guidance.overrides";
+
+	public static final boolean DEFAULT_ENABLED = true;
+	public static final int DEFAULT_MAX_RETRIES = 3;
+	public static final long DEFAULT_SESSION_TIMEOUT_MS = 45_000L;
+
+	private LivenessClientConfig() {
+	}
+
+	private static String raw(String key) {
+		try {
+			return ApplicationContext.getStringValueFromApplicationMap(key);
+		} catch (RuntimeException e) {
+			return null; // map not initialised
+		}
+	}
+
+	/** @return the device capture timeout in milliseconds (the client's own setting), 30 s when it is not set */
+	public static long captureTimeoutMillis() {
+		try {
+			int v = ApplicationContext.getIntValueFromApplicationMap(io.mosip.registration.constants.RegistrationConstants.CAPTURE_TIME_OUT);
+			return v > 0 ? v : 30_000L;
+		} catch (RuntimeException e) {
+			return 30_000L;
+		}
+	}
+
+	/**
+	 * Every engine setting (mosip.registration.liveness.*, with the .resident/.operator/.supervisor overrides) that the
+	 * client's configuration holds, so the engine's threshold, challenge types, minimum challenges, timeout and
+	 * per-workflow policy follow the client's configuration. Keys that are not set keep the engine defaults.
+	 */
+	public static java.util.Properties engineProperties() {
+		java.util.Properties p = new java.util.Properties();
+		for (String key : io.sajeev.policy.Config.DEFAULTS.keySet()) {
+			put(p, key);
+			for (String w : io.sajeev.policy.Config.WORKFLOWS) {
+				put(p, key + "." + w);
+			}
+		}
+		return p;
+	}
+
+	private static void put(java.util.Properties p, String suffix) {
+		String v = raw(PREFIX + suffix);
+		if (v != null && !v.trim().isEmpty()) {
+			p.setProperty(PREFIX + suffix, v.trim());
+		}
+	}
+
+	/** @return the folder with guidance text overrides, or "none" (the default) */
+	public static String guidanceOverrides() {
+		String v = raw(GUIDANCE_OVERRIDES);
+		return v == null || v.trim().isEmpty() ? "none" : v.trim();
+	}
+
+	/** @return false only when the value is exactly "false"; anything else keeps liveness on */
+	public static boolean enabled() {
+		String v = raw(ENABLED);
+		return v == null || !"false".equalsIgnoreCase(v.trim());
+	}
+
+	public static int maxRetries() {
+		try {
+			String v = raw(MAX_RETRIES);
+			int n = v == null ? DEFAULT_MAX_RETRIES : Integer.parseInt(v.trim());
+			return n < 1 ? DEFAULT_MAX_RETRIES : n;
+		} catch (NumberFormatException e) {
+			return DEFAULT_MAX_RETRIES;
+		}
+	}
+
+	public static long sessionTimeoutMillis() {
+		try {
+			String v = raw(SESSION_TIMEOUT_MS);
+			long n = v == null ? DEFAULT_SESSION_TIMEOUT_MS : Long.parseLong(v.trim());
+			return n < 1000 ? DEFAULT_SESSION_TIMEOUT_MS : n;
+		} catch (NumberFormatException e) {
+			return DEFAULT_SESSION_TIMEOUT_MS;
+		}
+	}
+}
