--- a/registration/registration-api/src/main/java/io/mosip/registration/api/liveness/LivenessFacade.java
+++ b/registration/registration-api/src/main/java/io/mosip/registration/api/liveness/LivenessFacade.java
@@ -19,6 +19,9 @@ public class LivenessFacade {
     @Autowired(required = false)
     private List<LivenessService> livenessServices;
 
+    @Autowired(required = false)
+    private List<LivenessSessionProvider> sessionProviders;
+
     public LivenessResult evaluate(String workflow, List<byte[]> frameJpegs) {
         if (livenessServices == null || livenessServices.isEmpty()) {
             LOGGER.warn("No liveness service registered: failing closed");
@@ -33,4 +36,55 @@ public class LivenessFacade {
             return new LivenessResult(LivenessOutcome.UNAVAILABLE, "service_error");
         }
     }
+
+    /**
+     * Open a liveness session. Fails closed: no provider, or a provider that throws, gives a session that is
+     * UNAVAILABLE for its whole life and never binds a capture.
+     *
+     * @param workflow RESIDENT, OPERATOR or SUPERVISOR
+     * @return a session handle; never null
+     */
+    public LivenessSessionHandle openSession(String workflow) {
+        if (sessionProviders == null || sessionProviders.isEmpty()) {
+            LOGGER.warn("No liveness session provider registered: failing closed");
+            return new UnavailableSession("no_liveness_service");
+        }
+        LivenessSessionProvider provider = sessionProviders.get(0);
+        try {
+            LivenessSessionHandle h = provider.open(workflow);
+            return h == null ? new UnavailableSession("null_session") : h;
+        } catch (RuntimeException e) {
+            LOGGER.error("Liveness provider " + provider.getServiceName() + " failed to open a session", e);
+            return new UnavailableSession("service_error");
+        }
+    }
+
+    /** A session that never reaches LIVE. */
+    private static final class UnavailableSession implements LivenessSessionHandle {
+        private final String reason;
+
+        UnavailableSession(String reason) {
+            this.reason = reason;
+        }
+
+        @Override
+        public void onFrame(byte[] jpeg) {
+            // nothing to do: this session can never become live
+        }
+
+        @Override
+        public LivenessProgress progress() {
+            return new LivenessProgress(LivenessProgress.Phase.UNAVAILABLE, null, "liveness.error.engine", reason);
+        }
+
+        @Override
+        public LivenessCaptureCheck checkCapture(byte[] capturedImage, long captureTimeoutMillis) {
+            return new LivenessCaptureCheck(false, reason);
+        }
+
+        @Override
+        public void close() {
+            // nothing held
+        }
+    }
 }
diff --git a/registration/registration-api/src/main/java/io/mosip/registration/api/liveness/LivenessProgress.java b/registration/registration-api/src/main/java/io/mosip/registration/api/liveness/LivenessProgress.java
new file mode 100644
index 0000000..867d7bc
--- /dev/null
+++ b/registration/registration-api/src/main/java/io/mosip/registration/api/liveness/LivenessProgress.java
@@ -0,0 +1,62 @@
+package io.mosip.registration.api.liveness;
+
+/**
+ * Where a liveness session stands, for the screen to show. Immutable.
+ * Only {@link Phase#LIVE} allows the face to be captured; every other phase refuses it (fail closed).
+ */
+public final class LivenessProgress {
+
+	/** The phase of the session. */
+	public enum Phase {
+		/** Frames are being checked; the screen shows the guidance or the challenge. */
+		RUNNING,
+		/** The person is live. The capture may be taken and must then be bound. */
+		LIVE,
+		/** A presentation attack or a failed challenge. The capture is refused. */
+		NOT_LIVE,
+		/** The engine is missing or failed, or the face could not be judged. Never treated as live. */
+		UNAVAILABLE
+	}
+
+	private final Phase phase;
+	private final String challenge;
+	private final String guidanceKey;
+	private final String reason;
+
+	/**
+	 * @param phase the phase
+	 * @param challenge the challenge to show now (for example BLINK), or null
+	 * @param guidanceKey a message key for the person (for example liveness.guidance.no_face), or null
+	 * @param reason a short machine-readable reason, for audit
+	 */
+	public LivenessProgress(Phase phase, String challenge, String guidanceKey, String reason) {
+		this.phase = phase;
+		this.challenge = challenge;
+		this.guidanceKey = guidanceKey;
+		this.reason = reason;
+	}
+
+	public Phase getPhase() {
+		return phase;
+	}
+
+	public String getChallenge() {
+		return challenge;
+	}
+
+	public String getGuidanceKey() {
+		return guidanceKey;
+	}
+
+	public String getReason() {
+		return reason;
+	}
+
+	public boolean isLive() {
+		return phase == Phase.LIVE;
+	}
+
+	public boolean isFinished() {
+		return phase != Phase.RUNNING;
+	}
+}
diff --git a/registration/registration-api/src/main/java/io/mosip/registration/api/liveness/LivenessSessionHandle.java b/registration/registration-api/src/main/java/io/mosip/registration/api/liveness/LivenessSessionHandle.java
new file mode 100644
index 0000000..027ccf3
--- /dev/null
+++ b/registration/registration-api/src/main/java/io/mosip/registration/api/liveness/LivenessSessionHandle.java
@@ -0,0 +1,25 @@
+package io.mosip.registration.api.liveness;
+
+/**
+ * One liveness check for one person at one step. Single use. {@link #onFrame} never blocks the caller.
+ */
+public interface LivenessSessionHandle extends AutoCloseable {
+
+	/** @param jpeg the next frame from the device stream */
+	void onFrame(byte[] jpeg);
+
+	/** @return the current progress; never null */
+	LivenessProgress progress();
+
+	/**
+	 * Check the captured face against what was seen live.
+	 * @param capturedImage the captured face as an image the engine can decode (JPEG or PNG)
+	 * @param captureTimeoutMillis the device's capture timeout
+	 * @return the check; bound is false if the session was not live
+	 */
+	LivenessCaptureCheck checkCapture(byte[] capturedImage, long captureTimeoutMillis);
+
+	/** Stop and release everything. Safe to call more than once. */
+	@Override
+	void close();
+}
